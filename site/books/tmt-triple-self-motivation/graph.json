    },
    {
      "id": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "type": "concept",
      "label": "Panchkosh Sanjeevan Vidya",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:meditation-practice",
      "content": "The revitalization-of-the-five-koshas technique used in TMT's meditation pillar: a yogic-philosophy practice that awakens the inner life-force through wisdom, by working through the five koshas (sheaths) that layer the human being — Annamaya, Pranamaya, Manomaya, Vijnanamaya and Anandamaya kosha."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:annamaya-kosha",
      "type": "vocabulary",
      "label": "Annamaya Kosha",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "vocabularyTerm": "Annamaya Kosha",
      "content": "The physical/food sheath — the body sustained by food; the outermost of the five koshas."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:pranamaya-kosha",
      "type": "vocabulary",
      "label": "Pranamaya Kosha",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "vocabularyTerm": "Pranamaya Kosha",
      "content": "The vital/energy sheath — the layer of life-force (prana) that animates the physical body."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:manomaya-kosha",
      "type": "vocabulary",
      "label": "Manomaya Kosha",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "vocabularyTerm": "Manomaya Kosha",
      "content": "The mental sheath — the layer of mind, thoughts and emotions."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:vijnanamaya-kosha",
      "type": "vocabulary",
      "label": "Vijnanamaya Kosha",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "vocabularyTerm": "Vijnanamaya Kosha",
      "content": "The wisdom/intellect sheath — the layer of discernment and higher knowing that guides right action."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:anandamaya-kosha",
      "type": "vocabulary",
      "label": "Anandamaya Kosha",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:panchkosh-sanjeevan-vidya",
      "vocabularyTerm": "Anandamaya Kosha",
      "content": "The bliss sheath — the innermost layer, experienced as pure joy/bliss, where the inner life-force is fully awakened. The Upanishads describe it as the kosha that follows the first four; identifying/experiencing it is the highest development of an individual's personality and the most refined state of being."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:tmt",
      "type": "vocabulary",
      "label": "TMT",
      "readingLevel": "analytical",
      "vocabularyTerm": "13 Minute Therapy",
      "content": "The full form of the book's title acronym: TMT stands for 13 Minute Therapy."
    },
    {
      "id": "tmt-triple-self-motivation:theme:scriptural-roots",
      "type": "theme",
      "label": "Scriptural Roots — Atharvaveda & Vedanta",
      "readingLevel": "inspectional",
      "parentId": "tmt-triple-self-motivation:book"
    },
    {
      "id": "tmt-triple-self-motivation:topic:atharvaveda-shaunaka",
      "type": "topic",
      "label": "Atharvaveda — Shaunaka Samhita",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "The Shaunaka Samhita of the Atharvaveda elaborately discusses karmaja vyadhi (disease arising from one's own karma) and gives a detailed, precise account of Sanjeevani Vidya and Devi Chikitsa (divine healing) as its treatment."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:karmaja-vyadhi",
      "type": "vocabulary",
      "label": "Karmaja Vyadhi",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:topic:atharvaveda-shaunaka",
      "vocabularyTerm": "Karmaja Vyadhi",
      "content": "Disease/affliction described in the Atharvaveda's Shaunaka Samhita as arising from one's own past karma."
    },
    {
      "id": "tmt-triple-self-motivation:concept:devi-chikitsa",
      "type": "concept",
      "label": "Devi Chikitsa (Divine Healing)",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:topic:atharvaveda-shaunaka",
      "content": "The divine-healing treatment the ancient rishis prescribed for karmaja vyadhi: mantra, tantra, yoga, yajna, tapa, herbal remedies and water-based treatments are all referred to as divine treatments; Panchakarma is cited as one such example.",
      "tags": ["mantra", "tantra", "yoga", "yajna", "tapa", "herbal-remedies", "water-based-treatments"]
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:panchakarma",
      "type": "vocabulary",
      "label": "Panchakarma",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:devi-chikitsa",
      "vocabularyTerm": "Panchakarma",
      "content": "One example of the divine treatments (Devi Chikitsa) referred to by the ancient rishis."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:mantra",
      "type": "vocabulary",
      "label": "Mantra",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:devi-chikitsa",
      "vocabularyTerm": "Mantra",
      "content": "That by repetition of which one can influence the mind."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:yoga",
      "type": "vocabulary",
      "label": "Yoga",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:devi-chikitsa",
      "vocabularyTerm": "Yoga",
      "content": "Stilling or regulating the fluctuations or modifications of the mind."
    },
    {
      "id": "tmt-triple-self-motivation:concept:mind-senses",
      "type": "concept",
      "label": "Mind's Hold Over the Senses",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "The mind influences our senses, pulling them toward outward worldly objects."
    },
    {
      "id": "tmt-triple-self-motivation:concept:sanjeevan-vidya",
      "type": "concept",
      "label": "Sanjeevan Vidya",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "The knowledge of Sanjeevan Vidya, part of Upanishad and Vedanta literature, encompasses Pranopchar, Panchkosh and Gayatri Tantra."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:pranopchar",
      "type": "vocabulary",
      "label": "Pranopchar",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:sanjeevan-vidya",
      "vocabularyTerm": "Pranopchar",
      "content": "One of the components of Sanjeevan Vidya, alongside Panchkosh and Gayatri Tantra."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:gayatri-tantra",
      "type": "vocabulary",
      "label": "Gayatri Tantra",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:concept:sanjeevan-vidya",
      "vocabularyTerm": "Gayatri Tantra",
      "content": "One of the components of Sanjeevan Vidya, alongside Pranopchar and Panchkosh."
    },
    {
      "id": "tmt-triple-self-motivation:concept:breath-mind-link",
      "type": "concept",
      "label": "Breath–Mind Link",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "When breathing is distracted or unstable, the mind also gets distracted."
    },
    {
      "id": "tmt-triple-self-motivation:concept:yogi-bliss",
      "type": "concept",
      "label": "The Yogi's Supreme Happiness",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "When the mind is focused away from material activities through the practice of yoga, one can see this self with a pure mind and rejoice in inner bliss. The yogi with a peaceful mind, free from impurities, attains supreme happiness."
    },
    {
      "id": "tmt-triple-self-motivation:topic:taittiriya-upanishad",
      "type": "topic",
      "label": "Taittiriya Upanishad",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "The Taittiriya Upanishad gives detailed account of the Panch Koshas that encapsulate a being's inner, pure consciousness."
    },
    {
      "id": "tmt-triple-self-motivation:concept:atman-brahman",
      "type": "concept",
      "label": "Atman / Brahman Within the Koshas",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:topic:taittiriya-upanishad",
      "content": "The Atman — pure consciousness, one with Brahman — resides inside the five koshas. One must detach from each kosha in turn to identify one's true self."
    },
    {
      "id": "tmt-triple-self-motivation:topic:gayatri-upasana",
      "type": "topic",
      "label": "Gayatri Upasana",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:theme:scriptural-roots",
      "content": "Goddess Gayatri is described as five-headed, signifying the Panchkoshas. Through the specialized method of Gayatri Upasana, one can achieve purification, healing and revitalization of the Panchkoshas — one of the most important aspects of spiritual development."
    },
    {
      "id": "tmt-triple-self-motivation:vocabulary:gayatri-mantra",
      "type": "vocabulary",
      "label": "Gayatri Mantra",
      "readingLevel": "analytical",
      "parentId": "tmt-triple-self-motivation:topic:gayatri-upasana",
      "vocabularyTerm": "Gayatri Mantra",
      "content": "The mantra which, when chanted with devotion, can influence and hence regulate the senses."
    }
