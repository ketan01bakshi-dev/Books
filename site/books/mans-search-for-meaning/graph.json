      "parentId": "mans-search-for-meaning:topic:psychology"
    },
    {
      "id": "mans-search-for-meaning:topic:nothingbutness",
      "type": "topic",
      "label": "Nothingbutness",
      "readingLevel": "analytical",
      "parentId": "mans-search-for-meaning:topic:principles"
    },
    {
      "id": "mans-search-for-meaning:quote:nb-q",
      "type": "quote",
      "label": "The theory that man is nothing but the result of biological,",
      "readingLevel": "analytical",
      "content": "The theory that man is nothing but the result of biological, psychological, and sociological conditions \u2014 the product of heredity and environment. This theory denies that man is free.",
      "parentId": "mans-search-for-meaning:topic:nothingbutness"
    },
    {
      "id": "mans-search-for-meaning:topic:panDeterminism",
      "type": "topic",
      "label": "Pan-determinism",
      "readingLevel": "analytical",
      "parentId": "mans-search-for-meaning:topic:principles"
    },
    {
      "id": "mans-search-for-meaning:quote:pd-q",
      "type": "quote",
      "label": "The view of man that disregards his capacity to take a stand",
      "readingLevel": "analytical",
      "content": "The view of man that disregards his capacity to take a stand toward any conditions whatsoever. Frankl's own view: man is not fully conditioned and determined, but rather determines himself \u2014 whether he gives in to conditions, or stands up to them.",
      "parentId": "mans-search-for-meaning:topic:panDeterminism"
    },
    {
      "id": "mans-search-for-meaning:quote:freedom-resp",
      "type": "quote",
      "label": "Freedom is only the negative aspect of the whole phenomenon,",
      "readingLevel": "analytical",
      "content": "Freedom is only the negative aspect of the whole phenomenon, whose positive aspect is responsibleness.",
      "parentId": "mans-search-for-meaning:topic:principles"
    },
    {
      "id": "mans-search-for-meaning:quote:innermost-core",
      "type": "quote",
      "label": "The innermost core of a patient's personality is not even to",
      "readingLevel": "analytical",
      "content": "The innermost core of a patient's personality is not even touched by a psychosis.",
      "parentId": "mans-search-for-meaning:topic:principles"
    },
    {
      "id": "mans-search-for-meaning:topic:tragic",
      "type": "theme",
      "label": "Tragic Optimism",
      "readingLevel": "inspectional",
      "parentId": "mans-search-for-meaning:book"
    },
    {
      "id": "mans-search-for-meaning:topic:triad",
      "type": "topic",
      "label": "The Tragic Triad",
      "readingLevel": "analytical",
      "parentId": "mans-search-for-meaning:topic:tragic"
    },
    {
      "id": "mans-search-for-meaning:quote:triad-q",
      "type": "quote",
      "label": "Pain, guilt, and death \u2014 the three facts of existence that o",
      "readingLevel": "analytical",
      "content": "Pain, guilt, and death \u2014 the three facts of existence that optimism cannot pretend away. Tragic optimism means staying capable of turning suffering into achievement, guilt into a chance to change for the better, and life's transience into a spur toward responsible action.",
      "parentId": "mans-search-for-meaning:topic:triad"
    },
    {
      "id": "mans-search-for-meaning:quote:second-time",
      "type": "quote",
      "label": "Live as if you were living already for the second time, and ",
      "readingLevel": "analytical",
      "content": "Live as if you were living already for the second time, and as if you had acted the first time as wrongly as you are about to act now!",
      "parentId": "mans-search-for-meaning:topic:tragic"
    },
    {
      "id": "mans-search-for-meaning:quote:defiant-spirit",
      "type": "quote",
      "label": "Even in the most extreme circumstances, a person keeps what ",
      "readingLevel": "analytical",
      "content": "Even in the most extreme circumstances, a person keeps what Frankl calls the defiant power of the human spirit \u2014 the capacity to rise above outward fate.",
      "parentId": "mans-search-for-meaning:topic:tragic"
    },
    {
      "id": "mans-search-for-meaning:topic:love",
      "type": "theme",
      "label": "Love",
      "readingLevel": "inspectional",
      "parentId": "mans-search-for-meaning:book"
    },
    {
      "id": "mans-search-for-meaning:quote:love-goal",
      "type": "quote",
      "label": "Love is the ultimate and the highest goal to which man can a",
      "readingLevel": "analytical",
      "content": "Love is the ultimate and the highest goal to which man can aspire. The salvation of man is through love and in love.",
      "parentId": "mans-search-for-meaning:topic:love"
    },
    {
      "id": "mans-search-for-meaning:quote:tilly",
      "type": "quote",
      "label": "Marching through the icy dark toward the work site, Frankl h",
      "readingLevel": "analytical",
      "content": "Marching through the icy dark toward the work site, Frankl held a mental image of his wife's face \u2014 proof to himself that love reaches its deepest meaning even when it is left with nothing to hold on to but the beloved's inner presence.",
      "parentId": "mans-search-for-meaning:topic:love"
    }
