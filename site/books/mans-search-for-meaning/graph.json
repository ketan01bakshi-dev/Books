    },
    {
      "id": "mans-search-for-meaning:quote:will-to-meaning-q",
      "type": "quote",
      "label": "Man's search for meaning is the primary motivation in his li",
      "readingLevel": "analytical",
      "content": "Man's search for meaning is the primary motivation in his life \u2014 not a \u201csecondary rationalization\u201d of instinctual drives, as Freud's will to pleasure or Adler's will to power would have the True engine be.",
      "parentId": "mans-search-for-meaning:topic:will-to-meaning"
    },
