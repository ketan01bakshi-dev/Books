    {
      "id": "mans-search-for-meaning:quote:psycho-1",
      "type": "quote",
      "label": "There is a close connection between the state of mind of a m",
      "readingLevel": "analytical",
      "content": "There is a close connection between the state of mind of a man \u2014 his courage and hope, or lack of them \u2014 and the state of immunity of his body.",
      "parentId": "mans-search-for-meaning:topic:psychosomatic"
    },
    {
      "id": "mans-search-for-meaning:quote:psycho-2",
      "type": "quote",
      "label": "The body has fewer inhibitions than the mind.",
      "readingLevel": "analytical",
      "content": "The body has fewer inhibitions than the mind.",
      "parentId": "mans-search-for-meaning:topic:psychosomatic"
    },
    {
