    {
      "id": "mans-search-for-meaning:topic:success",
      "type": "theme",
      "label": "Success",
      "readingLevel": "inspectional",
      "parentId": "mans-search-for-meaning:book"
    },
    {
      "id": "mans-search-for-meaning:quote:success-1",
      "type": "quote",
      "label": "Don't aim at success \u2014 the more you make it a target, the mo",
      "readingLevel": "analytical",
      "content": "Don't aim at success \u2014 the more you make it a target, the more you are going to miss it. You have to let it happen by not caring about it. Success, like happiness, cannot be pursued; it must ensue, and it only does so as the unintended side-effect of one's dedication to a cause greater than oneself, or as the by-product of one's surrender to a person other than oneself.",
      "parentId": "mans-search-for-meaning:topic:success"
    },
    {
      "id": "mans-search-for-meaning:quote:success-2",
      "type": "quote",
      "label": "Listen to what your conscience commands you to do, and go on",
      "readingLevel": "analytical",
      "content": "Listen to what your conscience commands you to do, and go on to carry it out to the best of your knowledge. Then you will live to see that, in the long run \u2014 in the long run, mind you \u2014 success will follow you, precisely because you had forgotten to think of it.",
      "parentId": "mans-search-for-meaning:topic:success"
    },
    {
      "id": "mans-search-for-meaning:topic:humour",
      "type": "theme",
      "label": "Humour",
      "readingLevel": "inspectional",
      "parentId": "mans-search-for-meaning:book"
    },
    {
      "id": "mans-search-for-meaning:quote:humour-1",
      "type": "quote",
      "label": "Humour was another of the soul's weapons in the fight for se",
      "readingLevel": "analytical",
      "content": "Humour was another of the soul's weapons in the fight for self-preservation. Humour, more than almost anything else in the human make-up, can afford an aloofness and an ability to rise above any situation, even if only for a few seconds.",
      "parentId": "mans-search-for-meaning:topic:humour"
    },
    {
      "id": "mans-search-for-meaning:topic:coldCuriosity",
      "type": "theme",
      "label": "Cold Curiosity",
      "readingLevel": "inspectional",
      "parentId": "mans-search-for-meaning:book"
    },
    {
      "id": "mans-search-for-meaning:quote:cold-1",
      "type": "quote",
      "label": "As a fundamental reaction to certain strange circumstances, ",
      "readingLevel": "analytical",
      "content": "As a fundamental reaction to certain strange circumstances, one's mind became somehow detached from its surroundings, which came to be regarded with a kind of objectivity. At that time one cultivated this state of mind as a means of protection.",
      "parentId": "mans-search-for-meaning:topic:coldCuriosity"
    },
    {
      "id": "mans-search-for-meaning:quote:cold-2",
      "type": "quote",
      "label": "We were anxious to know what would happen next, and what the",
      "readingLevel": "analytical",
      "content": "We were anxious to know what would happen next, and what the consequence would eventually be.",
      "parentId": "mans-search-for-meaning:topic:coldCuriosity"
    },
